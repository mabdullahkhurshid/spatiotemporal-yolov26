# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fire-detection-system

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
# Access tokens are short-lived (kept in memory by the SPA); the refresh token is an httpOnly cookie.
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
# Refresh cookie SameSite: strict (default; SPA and API on one site, as in nginx.conf) or none (separate
# sites, requires HTTPS). COOKIE_SECURE=true forces Secure outside production.
COOKIE_SAMESITE=strict
# COOKIE_SECURE=true

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@firedetection.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:5173

# Security
BCRYPT_ROUNDS=12
# General API limit per signed-in user (per IP for anonymous requests) per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Failed login/verification/reset attempts per IP per 15 min
AUTH_RATE_LIMIT_MAX=10
# Registration, verification-code and password-reset emails per IP per hour
EMAIL_RATE_LIMIT_MAX=10
# Contact form submissions per IP per hour
CONTACT_RATE_LIMIT_MAX=5
# Behind nginx / a load balancer set the number of proxy hops so limits see the real client IP.
# Leave unset when the backend is reached directly (otherwise X-Forwarded-For could be spoofed).
# TRUST_PROXY=1

# File Upload (if needed)
MAX_FILE_SIZE=5242880

# Python inference service (CPU / ONNX)
INFERENCE_SERVICE_API_KEY=change-me-inference-key
INFERENCE_LIVE_EMIT_MS=400
BACKEND_URL=http://localhost:5000
INFERENCE_MODEL_PATH=python-services/inference/weights/best.onnx
INFERENCE_FRAME_INTERVAL_MS=500
INFERENCE_MAX_CONCURRENT_CAMERAS=4

# RTSP → browser MJPEG proxy (requires ffmpeg on PATH)
FFMPEG_PATH=ffmpeg
# Lifetime of the camera-scoped token used in the live-view <img> URL
CAMERA_STREAM_TOKEN_TTL_SEC=60
# Camera stream URLs must be rtsp://, rtsps://, http:// or https:// to non-loopback, non-link-local hosts.
# Set true only for local demos (video file paths, file://, localhost stream servers).
CAMERA_ALLOW_LOCAL_SOURCES=false

# ONVIF cameras
# Key for encrypting stored camera passwords (any long random string). If unset, a key derived from
# JWT_SECRET is used, and rotating JWT_SECRET then requires re-entering camera passwords.
CAMERA_CREDENTIALS_KEY=change-me-camera-credentials-key
# LAN discovery (WS-Discovery). Default: on in development, off in production.
# ONVIF_DISCOVERY_ENABLED=true
# ONVIF_DISCOVERY_TIMEOUT_MS=3000
# Per-request timeout when talking to a camera
# ONVIF_TIMEOUT_MS=6000
# Connect / discover / refresh attempts per user per 5 minutes
# ONVIF_RATE_LIMIT_MAX=30
