{
  "name": "ai-fire-detection-system",
  "version": "1.0.0",
  "description": "AI-Based Smart Fire Detection and Emergency Monitoring System",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n server,client,inference -c blue,green,magenta \"npm run server\" \"npm run client\" \"npm run inference\"",
    "preserver": "node backend/scripts/freePort.js",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm run dev",
    "inference": "cd python-services/inference && python -m app.main",
    "explainer": "cd python-services/inference && python -m app.xai.main",
    "dev:xai": "concurrently -n server,client,inference,explainer -c blue,green,magenta,yellow \"npm run server\" \"npm run client\" \"npm run inference\" \"npm run explainer\"",
    "train:risk": "cd python-services/inference && python -m app.xai.train_risk",
    "seed:xai-demo": "node backend/scripts/seedXaiDemo.js",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d --build",
    "demo:down": "docker compose -f docker-compose.demo.yml down",
    "demo:logs": "docker compose -f docker-compose.demo.yml logs -f --tail 50",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "install-all": "npm install && cd frontend && npm install",
    "test": "node --test --test-concurrency=1 \"backend/tests/*.test.js\"",
    "test:inference": "cd python-services/inference && python -m unittest discover -s tests -t ."
  },
  "keywords": [
    "fire-detection",
    "ai",
    "monitoring",
    "mern"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^4.5.3",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.6.1",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
