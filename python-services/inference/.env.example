BACKEND_URL=http://localhost:5000
INFERENCE_SERVICE_API_KEY=change-me-inference-key
INFERENCE_MODEL_PATH=./weights/best.onnx
INFERENCE_CONF_THRESHOLD=0.35
INFERENCE_IOU_THRESHOLD=0.45
INFERENCE_FRAME_INTERVAL_MS=500
INFERENCE_MAX_CONCURRENT_CAMERAS=4
# Consecutive positive frames before an alert / before an incident is opened
INFERENCE_MIN_CONSECUTIVE=3
INFERENCE_INCIDENT_MIN_CONSECUTIVE=3
# Explainer process (python -m app.xai.main); install requirements-xai.txt
XAI_MODEL_PATH=./weights/best.pt
XAI_RISK_MODEL_PATH=./weights/risk_model.joblib
XAI_POLL_MS=3000
XAI_TORCH_THREADS=2
XAI_MAX_TARGETS=3
# Retrain the false-alarm model from operator outcomes (0 = only at start-up / npm run train:risk)
XAI_RETRAIN_HOURS=24
XAI_MIN_SAMPLES=150
XAI_MIN_PER_CLASS=30
