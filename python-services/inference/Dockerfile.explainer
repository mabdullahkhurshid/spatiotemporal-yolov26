FROM python:3.11-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-xai.txt ./
RUN pip install --no-cache-dir -r requirements-xai.txt

COPY app ./app
COPY config ./config

ENV INFERENCE_MODEL_PATH=/app/weights/best.onnx
ENV XAI_MODEL_PATH=/app/weights/best.pt
ENV XAI_RISK_MODEL_PATH=/app/weights/risk_model.joblib
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "app.xai.main"]
